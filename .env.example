# ─── Inbound auth (Bubble → middleware) ───
MIDDLEWARE_API_SECRET=          # Shared secret — Bubble sends this as Bearer token

# ─── Salesforce OAuth (Resource Owner Password grant) ───
SF_BASE_URL=https://balo.my.salesforce.com
SF_API_VERSION=v65.0
SF_CLIENT_ID=                   # Connected App consumer key
SF_CLIENT_SECRET=               # Connected App consumer secret
SF_USERNAME=                    # SF integration user
SF_PASSWORD=                    # SF integration user password (may include security token)

# ─── Redis ───
REDIS_URL=redis://localhost:6379

# ─── Axiom (structured logging) ───
AXIOM_DATASET=sf-middleware
AXIOM_TOKEN=                    # Axiom API token (xaat-...)
AXIOM_ORG_ID=                   # Axiom organisation ID (found on settings page)

# ─── Slack (Incoming Webhook URLs) ───
SLACK_WEBHOOK_ACTIVITY=         # #sf-sync-activity channel webhook
SLACK_WEBHOOK_ERRORS=           # #sf-sync-errors channel webhook

# ─── Daily digest schedule ───
DIGEST_CRON=0 7 * * *           # 07:00 UTC = 5:00 PM AEST

# ─── Bull Board admin UI ───
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=            # Strong password for /admin/queues UI

# ─── Server ───
PORT=3000
NODE_ENV=production
